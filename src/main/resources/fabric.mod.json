{
	"schemaVersion": 1,
	"id": "monosleep",
	"version": "${version}",
	"name": "monosleep",
	"description": "Server-side mod that lets a single sleeping player skip the night, no matter how many other players are online.",
	"authors": [
		"vanja-san"
	],
	"contact": {
		"homepage": "https://github.com/vanja-san/monosleep",
		"sources": "https://github.com/vanja-san/monosleep"
	},
	"license": "CC0-1.0",
	"icon": "assets/monosleep/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"monosleep.Monosleep"
		],
		"fabric-datagen": [
			"monosleep.data.MonosleepDataGenerator"
		]
	},
	"mixins": [
		"monosleep.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
